{
  "name": "@aburi/framework-nestjs",
  "version": "0.6.0",
  "description": "Aburi NestJS framework plugin: recognizes @Module / @Controller / @Injectable / @Catch / @Resolver / @WebSocketGateway classes, HTTP (@Sse included), microservice, WebSocket, gRPC and GraphQL handlers, @Cron / @Interval / @Timeout / @OnEvent handlers, and Guards / Interceptors / Pipes / Filters. Emits framework:nestjs:* extKinds and toggles decorator boundary flags on classified Symbols",
  "license": "Apache-2.0",
  "author": "kage1020",
  "homepage": "https://github.com/aburi-dev/Aburi/tree/main/packages/framework-nestjs#readme",
  "bugs": {
    "url": "https://github.com/aburi-dev/Aburi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aburi-dev/Aburi.git",
    "directory": "packages/framework-nestjs"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aburi/core": "workspace:*",
    "@aburi/plugin-registry": "workspace:*",
    "@aburi/types": "workspace:*"
  },
  "devDependencies": {
    "@aburi/lang-typescript": "workspace:*",
    "@aburi/test-harness": "workspace:*",
    "@aburi/test-support": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
